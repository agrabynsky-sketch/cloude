[Unit]
Description=cdn.unit.travel secure uploader
After=network.target

[Service]
User=unitcdn
Group=unitcdn
WorkingDirectory=/opt/unit-uploader
EnvironmentFile=/etc/unit-uploader.env
# One worker: per-token counters and rate limits are kept in process memory.
ExecStart=/opt/unit-uploader/venv/bin/uvicorn --factory uploader.app:create_app \
    --host 127.0.0.1 --port 8000 --workers 1 \
    --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-server-header
Restart=on-failure
UMask=0022

# Sandboxing: the service can write only to the storage directory.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/unit-cdn/f
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=
MemoryMax=2G
TasksMax=64

[Install]
WantedBy=multi-user.target

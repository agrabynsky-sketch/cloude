# Copy to /etc/unit-uploader.env (chmod 600) and fill in.

# Secret key for file names (HMAC). Generate once and never change it,
# otherwise identical files stop deduplicating:
#   python3 -c 'import secrets; print(secrets.token_hex(32))'
UPLOADER_HASH_KEY=

# Applications allowed to open the uploader. Each gets its own secret
# (32+ chars) used by its backend to sign upload tokens, and the exact
# origins of the pages that open the modal.
UPLOADER_CLIENTS={"booking":{"secret":"<random 64 hex chars>","origins":["https://unit.travel","https://app.unit.travel"]}}
# ...or keep the same JSON in a file:
# UPLOADER_CLIENTS_FILE=/etc/unit-uploader-clients.json

UPLOADER_STORAGE_DIR=/srv/unit-cdn/f
UPLOADER_CDN_BASE_URL=https://cdn.unit.travel/f

# Limits
UPLOADER_MAX_FILE_MB=50
UPLOADER_MAX_UNCOMPRESSED_MB=200
UPLOADER_ARCHIVE_MAX_ENTRIES=1000
UPLOADER_ARCHIVE_MAX_NESTING=1
UPLOADER_IMAGE_MAX_PIXELS=40000000
UPLOADER_TOKEN_MAX_TTL=3600
UPLOADER_MAX_FILES_PER_TOKEN=50
UPLOADER_RATE_LIMIT_PER_MINUTE=120
UPLOADER_MAX_CONCURRENT_JOBS=4

# ClamAV (optional): unix:/run/clamav/clamd.ctl or tcp:127.0.0.1:3310
UPLOADER_CLAMD=
# 1 = reject uploads while clamd is down (recommended), 0 = accept unscanned
UPLOADER_CLAMD_REQUIRED=1

# Serve /f/ from the Python app. Development only; nginx does it in production.
UPLOADER_SERVE_FILES=0

# Credentials Exely Channel Manager sends in every request (we issue them to Exely).
EXELY_USERNAME=exely
EXELY_PASSWORD=change-me
# Path of the channel endpoint registered with Exely.
EXELY_PATH=/exely
# Booking notification URL Exely assigns after certification; empty disables it.
EXELY_NOTIFY_URL=

# Unit.Travel Partner API: sandbox https://api.test.unit.travel/partner/v1,
# production https://api.unit.travel/partner/v1
UT_BASE_URL=https://api.test.unit.travel/partner/v1
UT_API_KEY=change-me
UT_TIMEOUT_SECONDS=30
# Secret for X-UnitTravel-Signature; empty disables /webhooks/unit-travel.
UT_WEBHOOK_SECRET=
# Pull /reservations of every active connection on each get-bookings call.
UT_PULL_RESERVATIONS=true
# Send Exely's confirmation in the acknowledge body (needs Partner API support).
UT_ACK_WITH_DETAILS=false

# SQLite, or e.g. postgresql+psycopg://user:pass@host/db, mysql+pymysql://user:pass@host/db
DATABASE_URL=sqlite:///./exely_adapter.db

ARI_STATUS_WAIT_SECONDS=10
ARI_STATUS_POLL_INTERVAL=0.5
ARI_MAX_ITEMS_PER_MESSAGE=1000
BOOKING_RELEVANCE_DAYS=60
